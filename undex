// 🚀 NATIVE AnimeNexus VIP PLAYER FUNCTION
async function playEp(ep, options={}) {
  clearInterval(window.autoNextInterval);
  destroyActivePlayer();
  ep = parseInt(ep); 
  if(ep < 1 || ep > state.totalEps) return;
  state.currentEp = ep;
  if(options.resumeTime!=null) pendingResumeTime=Number(options.resumeTime)||0;
  if(options.autoFullscreen!=null) pendingAutoFullscreen=!!options.autoFullscreen;
  if(state.lang!=='sub' && state.lang!=='dub') state.lang=getDefaultLang();
  if(!PROVIDERS[state.provider]) state.provider=getDefaultProvider();
  if (window.isPartyHost) {
      broadcastToParty({
          type: 'SYNC',
          animeId: state.animeId,
          ep: ep,
          isPlaying: isAutoPlay,
          time: 0
      });
  }
  updateEpLabel(ep);
  document.querySelectorAll('.ep-box').forEach(b => b.classList.remove('active'));
  const activeBox = document.querySelector(`.ep-box[data-ep="${ep}"]`);
  if(activeBox) {
    activeBox.classList.add('active', 'watched');
    activeBox.scrollIntoView({behavior:'smooth', block:'nearest'});
  }
  
  const playerWrap = document.getElementById('player-wrap');

  if (true) {
      playerWrap.innerHTML = `<div class="player-loading" id="p-loader"> Loading Stream...</div>`;
      const skipTimes = [];

      const apiUrl = `https://anivexa-api-tawny.vercel.app/watch/anikoto/${state.animeId}/${state.lang}/anikoto-${ep}`;
      const PROXY_BASE = "https://kagewatch-kagewatch-proxy.hf.space/proxy"; // VIP stream proxy

      fetch(apiUrl).then(r => r.json()).then(async (data) => {
          
          await ensureVideoScripts();
          
          let requestedLang = state.lang === 'dub' ? 'dub' : 'sub';
          let streamData = requestedLang === 'dub' ? data?.sdub : data?.ssub;

          // If the saved/default language is unavailable, silently switch to the
          // language that actually has a stream. NEVER switch the server/provider.
          if (!streamData || !Array.isArray(streamData.streams) || streamData.streams.length === 0) {
              if (options._languageFallbackTried) {
                throw new Error(`${requestedLang.toUpperCase()} is unavailable and no alternate language stream was returned.`);
              }
              const fallbackLang = requestedLang === 'dub' ? 'sub' : 'dub';
              const fallbackData = fallbackLang === 'dub' ? data?.sdub : data?.ssub;
              if (fallbackData && Array.isArray(fallbackData.streams) && fallbackData.streams.length) {
                state.lang = fallbackLang;
                document.getElementById('lang-sub')?.classList.toggle('active', state.lang === 'sub');
                document.getElementById('lang-dub')?.classList.toggle('active', state.lang === 'dub');
                localStorage.setItem('anexus_default_lang', fallbackLang);
                // Retry the SAME episode with the SAME provider/server selection.
                // Keep the saved playback position and fullscreen intent.
                return playEp(ep, {...options, resumeTime: options.resumeTime != null ? options.resumeTime : pendingResumeTime, _languageFallbackTried:true});
              }
              throw new Error(`Neither SUB nor DUB is available for Episode ${ep}.`);
          }
          
          const stream = streamData.streams.find(s => s.server === 'VidPlay-1' && s.type === 'hls')
                      || streamData.streams.find(s => s.type === 'hls' && s.default)
                      || streamData.streams.find(s => s.type === 'hls');

          const rawUrl = stream.url;
          const referer = stream.referer || "";
          const proxyUrl = `${PROXY_BASE}?url=${encodeURIComponent(rawUrl)}&referer=${encodeURIComponent(referer)}`;

          const subSource = streamData.subtitles?.filter(s => s && s.source === stream.server) || [];
          const subsToUse = subSource.length > 0 ? subSource : (streamData.subtitles || []);
          const tracksHtml = buildSubtitleTracks(subsToUse, referer, state.lang);

          // VIP stream only: the player uses the first supported HLS stream returned by the VIP API.
          window.anexusStreamChoices = [];
          window.anexusCurrentStreamIndex = 0;

          playerWrap.innerHTML = `
              <div class="player-loading" id="p-loader" style="display:none;"></div>
              <video id="anime-player" crossorigin="anonymous" playsinline webkit-playsinline="true" style="width:100%; height:100%;">
                  ${tracksHtml}
              </video>
              <button id="skip-btn">Skip ⏭️</button>
              
              <button id="auto-next-btn" onclick="playEp(${ep + 1})">
                 <div class="anb-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l15 8-15 8z"/></svg>
                 </div>
                 <div class="anb-info">
                   <span class="anb-label">Up Next</span>
                   <span class="anb-time" id="anb-text">Playing in 10s</span>
                 </div>
              </button>
          `;

          const video = document.getElementById('anime-player');
          let plyrPlayer = null;

          const injectCustomButtons = (playerInstance) => {
              const plyrContainer = playerWrap.querySelector('.plyr');
              const skipBtn = document.getElementById('skip-btn');
              const nextBtn = document.getElementById('auto-next-btn');
              if (plyrContainer) {
                  if (skipBtn) plyrContainer.appendChild(skipBtn);
                  if (nextBtn) plyrContainer.appendChild(nextBtn);
                  
                  // Bind mobile double tap events
                  const videoWrapper = plyrContainer.querySelector('.plyr__video-wrapper');
                  if (videoWrapper) {
                      videoWrapper.addEventListener('touchstart', (e) => {
                          if (typeof handlePlayerDoubleTap === 'function') {
                              handlePlayerDoubleTap(e, playerInstance);
                          }
                      }, { passive: false });
                  }
              }
              // The player is now created; keep it in our own viewport fullscreen on every device.
              if(pendingAutoFullscreen || document.body.classList.contains('anexus-player-fullscreen')){
                  const watchView=document.getElementById('watch-view');
                  watchView?.classList.add('anexus-direct-player');
                  enterAnexusWebFullscreen(playerInstance);
              }
              setupPlayerLogic(playerInstance, skipBtn, skipTimes, ep);
              injectPlayerMenu(playerInstance);
          };

// --- DEVICE DETECTION ---
          const isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
          const isAndroid = /Android/i.test(navigator.userAgent);
          const isMobile = isIOS || isAndroid;

          // ALL DEVICES USE THE SAME HLS + PLYR PLAYER.
          // The old mobile branch selected native Android controls, which
          // was the path that was failing.
          video.controls = false;
          video.setAttribute('playsinline', 'true');
          video.setAttribute('webkit-playsinline', 'true');
          video.setAttribute('x5-playsinline', 'true');

          if (window.activePlyrInstance && typeof window.activePlyrInstance.destroy === 'function') {
              try { window.activePlyrInstance.destroy(); } catch (_) {}
              window.activePlyrInstance = null;
          }
          if (window.activeHlsInstance) {
              try { window.activeHlsInstance.destroy(); } catch (_) {}
              window.activeHlsInstance = null;
          }

          // ALL DEVICES use the same AnimeNexus/Plyr player.
          // iPhone/iPad no longer enter Safari's native video player.
          if (window.Hls && Hls.isSupported()) {
              const hls = new Hls({
                  maxBufferLength: 30,
                  maxMaxBufferLength: 90,
                  enableWorker: true,
                  backBufferLength: 30
              });
              window.activeHlsInstance = hls;

              // Android is happier when the media is attached before loading.
              hls.attachMedia(video);

              hls.on(Hls.Events.MEDIA_ATTACHED, () => {
                  hls.loadSource(proxyUrl);
              });

              hls.on(Hls.Events.MANIFEST_PARSED, () => {
                  const availableQualities = hls.levels
                      .map(l => l.height)
                      .filter((v, i, a) => a.indexOf(v) === i && v > 0)
                      .sort((a, b) => b - a);
                  availableQualities.unshift(0);

                  // EXACT SAME PLAYER CONTROLS/QUALITY SYSTEM AS PC.
                  plyrPlayer = new Plyr(video, {
                      controls: [
                          'play-large', 'rewind', 'play', 'fast-forward',
                          'progress', 'current-time', 'duration', 'mute',
                          'volume', 'captions', 'settings', 'pip', 'fullscreen'
                      ],
                      settings: ['captions', 'quality', 'speed'],
                      captions: { active: true, update: true, language: 'en' },
                      quality: {
                          default: 0,
                          options: availableQualities,
                          forced: true,
                          onChange: (value) => {
                              hls.currentLevel = value === 0
                                  ? -1
                                  : hls.levels.findIndex(level => level.height === value);
                          }
                      },
                      i18n: { qualityLabel: { 0: 'Auto' } }
                  });

                  window.activePlyrInstance = plyrPlayer;

                  if (isAutoPlay) video.play().catch(() => {});
                  injectCustomButtons(plyrPlayer);
              });

              hls.on(Hls.Events.ERROR, (event, data) => {
                  if (!data.fatal) return;

                  if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
                      try { hls.startLoad(); return; } catch (_) {}
                  }
                  if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
                      try { hls.recoverMediaError(); return; } catch (_) {}
                  }

                  const loader = document.getElementById('p-loader');
                  if (loader) {
                      loader.style.display = "flex";
                      loader.innerHTML = "Stream Error. Please use Backup Server.";
                  }
              });
          } else {
              // Direct/native fallback, still wrapped in Plyr.
              video.src = proxyUrl;
              plyrPlayer = new Plyr(video, {
                  controls: [
                      'play-large', 'rewind', 'play', 'fast-forward',
                      'progress', 'current-time', 'duration', 'mute',
                      'volume', 'captions', 'settings', 'pip', 'fullscreen'
                  ],
                  settings: ['captions', 'speed']
              });
              window.activePlyrInstance = plyrPlayer;
              if (isAutoPlay) video.play().catch(() => {});
              injectCustomButtons(plyrPlayer);
          }

      }).catch(err => {
          playerWrap.innerHTML = `<div class="player-loading">❌ ${err.message}</div>`;
      });

  }
  
  const h=Store.get('otaku_hist'); const oldHist=h[state.animeId]||{}; const eps=oldHist.eps||[]; if(!eps.includes(ep)) eps.push(ep);
  const sameEpisode = Number(oldHist.ep) === Number(ep);
  const savedPosition = options.resumeTime!=null ? Number(options.resumeTime)||0 : (sameEpisode ? Number(oldHist.position)||0 : 0);
  Store.addHist(state.animeId,{animeId:state.animeId, title:state.animeTitle, cover:state.animeCover, banner: (String(state.animeId) === '21' ? ONE_PIECE_CUSTOM_COVER : (state.animeBanner || state.animeCover)), ep, total:state.totalEps, eps, lang:state.lang, provider:'AnimeNexus', position:savedPosition, remainingTime:savedPosition>0?`${Math.floor(savedPosition/60)}:${String(Math.floor(savedPosition%60)).padStart(2,'0')}`:''});
}


