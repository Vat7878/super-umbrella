  let datesHTML = '';
  for (let i = -1; i < 6; i++) { 
    let d = new Date();
    d.setDate(d.getDate() + i);
    let activeCls = i === 0 ? 'active' : '';
    
    let startOfDay = Math.floor(new Date(d.getFullYear(), d.getMonth(), d.getDate(), 0, 0, 0).getTime() / 1000);
    let endOfDay = Math.floor(new Date(d.getFullYear(), d.getMonth(), d.getDate(), 23, 59, 59).getTime() / 1000);
    
