function showEpisodePlayer(ep,opts={}){
  if(!ep||ep<1||ep>state.totalEps)return;
  const view=document.getElementById('watch-view');
  if(!view)return;
  view.classList.remove('player-options-mode');
  view.classList.add('player-mode','anexus-direct-player');
  document.body.classList.add('anexus-player-fullscreen');
  window.scrollTo(0,0);
  // Enter our own fullscreen shell immediately. This does not depend on Safari's
  // native video fullscreen or a later async promise, so iPhone/iPad can use the
  // exact same AnimeNexus player as Android and desktop.
  if(opts.autoFullscreen!==false){
    document.body.classList.add('anexus-player-fullscreen');
    const existingBox=view.querySelector('.player-container');
    if(existingBox) existingBox.classList.add('anexus-web-fullscreen');
  }
  pendingResumeTime=opts.resumeTime!=null ? Number(opts.resumeTime)||0 : null;
  pendingAutoFullscreen=opts.autoFullscreen!==false;
  playEp(ep,{resumeTime:pendingResumeTime,autoFullscreen:pendingAutoFullscreen});
}
