let videoScriptsLoaded = null;
function ensureVideoScripts() {
  if (videoScriptsLoaded) return videoScriptsLoaded;
  videoScriptsLoaded = new Promise((resolve, reject) => {
    if (typeof Hls !== 'undefined' && typeof Plyr !== 'undefined') {
      resolve();
      return;
    }
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://cdn.plyr.io/3.7.8/plyr.css';
    document.head.appendChild(link);
    
    const sHls = document.createElement('script');
    sHls.src = 'https://cdn.jsdelivr.net/npm/hls.js@latest';
    sHls.async = true;
    sHls.onload = () => {
      const sPlyr = document.createElement('script');
      sPlyr.src = 'https://cdn.plyr.io/3.7.8/plyr.polyfilled.js';
      sPlyr.async = true;
      sPlyr.onload = () => resolve();
      sPlyr.onerror = (err) => reject(new Error('Failed to load Plyr player library'));
      document.head.appendChild(sPlyr);
    };
    sHls.onerror = (err) => reject(new Error('Failed to load HLS streaming library'));
    document.head.appendChild(sHls);
  });
  return videoScriptsLoaded;
}

let peerScriptLoaded = null;
function ensurePeerScript() {
  if (peerScriptLoaded) return peerScriptLoaded;
  peerScriptLoaded = new Promise((resolve, reject) => {
    if (typeof Peer !== 'undefined') {
      resolve();
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js';
    script.async = true;
    script.onload = () => resolve();
    script.onerror = (err) => reject(new Error('Failed to load PeerJS library'));
    document.head.appendChild(script);
  });
  return peerScriptLoaded;
}

