/* Custom player overlay feedback */
.plyr-doubletap-overlay {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 35%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 10;
}
.plyr-doubletap-overlay.left {
  left: 0;
  border-top-left-radius: 8px;
  border-bottom-left-radius: 8px;
}
.plyr-doubletap-overlay.right {
  right: 0;
  border-top-right-radius: 8px;
  border-bottom-right-radius: 8px;
}
.plyr-doubletap-overlay.show {
  opacity: 1;
  animation: doubleTapFlash 0.6s ease forwards;
}
.plyr-doubletap-icon {
  font-size: 2rem;
  margin-bottom: 8px;
  color: #fff;
  animation: arrowBounce 0.4s infinite alternate;
}
.plyr-doubletap-text {
  font-size: 0.8rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
}

@keyframes doubleTapFlash {
  0% { opacity: 0; }
  30% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; }
}
@keyframes arrowBounce {
  from { transform: translateX(0); }
  to { transform: translateX(5px); }
}
.plyr-doubletap-overlay.left .plyr-doubletap-icon {
  animation-name: arrowBounceLeft;
}
@keyframes arrowBounceLeft {
