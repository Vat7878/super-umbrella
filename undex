function getLandingSeasonGroups(){
  const total=Math.max(1,Number(state.totalEps)||1);
  const blockSize=total>150?100:total>52?26:total;
  const groups=[];
  for(let start=1,n=1;start<=total;start+=blockSize,n++) groups.push({number:n,start,end:Math.min(total,start+blockSize-1)});
  return groups;
}
