function setupDragScroll() {
  const sliders = document.querySelectorAll('.h-scroll, .genre-filters');
  let isDown = false, startX, scrollLeft;
  sliders.forEach(s => {
    s.addEventListener('mousedown', e => { isDown = true; startX = e.pageX - s.offsetLeft; scrollLeft = s.scrollLeft; });
    s.addEventListener('mouseleave', () => { isDown = false; s.classList.remove('dragging'); });
    s.addEventListener('mouseup', () => { isDown = false; s.classList.remove('dragging'); });
    s.addEventListener('mousemove', e => {
      if (!isDown) return; e.preventDefault();
      s.classList.add('dragging'); 
      const walk = (e.pageX - s.offsetLeft - startX) * 1.5;
      s.scrollLeft = scrollLeft - walk;
    });
  });
}

