let filterAbortController = null;
async function executeAdvancedFilter() {
  if (filterAbortController) {
    filterAbortController.abort();
  }
  filterAbortController = new AbortController();

  showSearchSkeleton();
  
  const format = document.getElementById('adv-f-type').value;
  const status = document.getElementById('adv-f-status').value;
  const rated = document.getElementById('adv-f-rated').value;
  const score = document.getElementById('adv-f-score').value;
  const season = document.getElementById('adv-f-season').value;
  const year = document.getElementById('adv-f-year').value;
  const sort = document.getElementById('adv-f-sort').value || 'TRENDING_DESC';

  let queryArgs = `$s: [MediaSort]`;
  let mediaArgs = `sort: $s, type: ANIME`;
  let vars = { s: [sort] };

  if (rated === "true") { mediaArgs += `, isAdult: true`; } 
  else if (rated === "false") { mediaArgs += `, isAdult: false`; }

  if (format) { queryArgs += `, $format: MediaFormat`; mediaArgs += `, format: $format`; vars.format = format; }
  if (status) { queryArgs += `, $status: MediaStatus`; mediaArgs += `, status: $status`; vars.status = status; }
  if (season) { queryArgs += `, $season: MediaSeason`; mediaArgs += `, season: $season`; vars.season = season; }
  if (score) { queryArgs += `, $score: Int`; mediaArgs += `, averageScore_greater: $score`; vars.score = parseInt(score); }
  if (year) { queryArgs += `, $year: Int`; mediaArgs += `, seasonYear: $year`; vars.year = parseInt(year); }
  if (advSelectedGenres.length > 0) { queryArgs += `, $g: [String]`; mediaArgs += `, genre_in: $g`; vars.g = advSelectedGenres; }

  const q = `query(${queryArgs}){ Page(perPage:40){ media(${mediaArgs}){ id title{romaji english} coverImage{large extraLarge} episodes averageScore startDate{year} format genres status bannerImage description } } }`;

  document.getElementById('sv-title').textContent = "Filtered Results";
  document.getElementById('sv-subtitle').textContent = "Based on your selections";

  try {
    const d = await alQ(q, vars, filterAbortController.signal);
    fillSearchView(d?.Page?.media || []);
  } catch (err) {
    if (err.name !== 'AbortError') {
      console.error("Advanced Filter Error:", err);
    }
  }
}

