// ── CUSTOM PLAYER KEYBOARD SHORTCUTS & MOBILE DOUBLE TAP ──
let lastTap = 0;
let tapTimeout = null;

function handlePlayerDoubleTap(e, player) {
  if (e.type === 'touchstart') {
    const currentTime = new Date().getTime();
    const tapLength = currentTime - lastTap;
    
    if (tapLength < 300 && tapLength > 0) {
      clearTimeout(tapTimeout);
      
      const touch = e.touches[0];
      const rect = e.currentTarget.getBoundingClientRect();
      const x = touch.clientX - rect.left;
      const width = rect.width;
      
      if (x < width * 0.35) {
        player.currentTime = Math.max(0, player.currentTime - 10);
        showDoubleTapOverlay('left', e.currentTarget);
        e.preventDefault();
      } else if (x > width * 0.65) {
        player.currentTime = Math.min(player.duration || 0, player.currentTime + 10);
        showDoubleTapOverlay('right', e.currentTarget);
        e.preventDefault();
      }
    }
    lastTap = currentTime;
  }
}

function showDoubleTapOverlay(side, parentEl) {
  let overlay = parentEl.querySelector(`.plyr-doubletap-overlay.${side}`);
  if (!overlay) {
    overlay = document.createElement('div');
    overlay.className = `plyr-doubletap-overlay ${side}`;
    overlay.innerHTML = `
      <div class="plyr-doubletap-icon">${side === 'left' ? '◀◀' : '▶▶'}</div>
      <div class="plyr-doubletap-text">10s</div>
    `;
    parentEl.appendChild(overlay);
  }
  overlay.classList.remove('show');
  void overlay.offsetWidth; // Trigger reflow to restart animation
  overlay.classList.add('show');
}

// Global Key Listeners
document.addEventListener('keydown', (e) => {
  const activeEl = document.activeElement;
  if (activeEl && (
    activeEl.tagName === 'INPUT' || 
    activeEl.tagName === 'TEXTAREA' || 
    activeEl.tagName === 'SELECT' || 
    activeEl.isContentEditable
  )) {
    return;
  }

  const player = window.playerInstance;
  if (!player) return;

  const key = e.key.toLowerCase();
  
  if (e.code === 'Space') {
    e.preventDefault();
    if (player.paused) {
      player.play().catch(() => {});
    } else {
      player.pause();
    }
  }
  else if (key === 'f') {
    e.preventDefault();
    player.fullscreen.toggle();
  }
  else if (key === 'm') {
    e.preventDefault();
    player.muted = !player.muted;
  }
  else if (e.key === 'ArrowLeft') {
    e.preventDefault();
    player.currentTime = Math.max(0, player.currentTime - 10);
  }
  else if (e.key === 'ArrowRight') {
    e.preventDefault();
    player.currentTime = Math.min(player.duration || 0, player.currentTime + 10);
  }
  else if (e.key === 'ArrowUp') {
    e.preventDefault();
    player.volume = Math.min(1, player.volume + 0.1);
  }
  else if (e.key === 'ArrowDown') {
    e.preventDefault();
    player.volume = Math.max(0, player.volume - 0.1);
  }
});

window.handlePlayerDoubleTap = handlePlayerDoubleTap;
window.showDoubleTapOverlay = showDoubleTapOverlay;

// ── AnimeNexus ADVANCED PERFORMANCE ANALYTICS ──
const KageWatchAnalytics = {
  metrics: {
    LCP: null,
    FID: null,
    CLS: 0,
    INP: 0,
    FPS: 60,
    usedMemoryMB: 0,
    apiLatencies: []
  },
  
  init() {
    this.observeVitals();
    this.trackFPS();
    this.trackMemory();
    this.setupConsoleReport();
  },
  
  observeVitals() {
    try {
      const lcpObserver = new PerformanceObserver((entryList) => {
        const entries = entryList.getEntries();
        const lastEntry = entries[entries.length - 1];
        this.metrics.LCP = (lastEntry.startTime / 1000).toFixed(2) + 's';
      });
      lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });

      const fidObserver = new PerformanceObserver((entryList) => {
        const entries = entryList.getEntries();
        if (entries.length > 0) {
          this.metrics.FID = entries[0].processingStart - entries[0].startTime + 'ms';
        }
      });
      fidObserver.observe({ type: 'first-input', buffered: true });

      const clsObserver = new PerformanceObserver((entryList) => {
        for (const entry of entryList.getEntries()) {
          if (!entry.hadRecentInput) {
            this.metrics.CLS += entry.value;
          }
        }
      });
      clsObserver.observe({ type: 'layout-shift', buffered: true });

      const inpObserver = new PerformanceObserver((entryList) => {
        for (const entry of entryList.getEntries()) {
          if (entry.duration > this.metrics.INP) {
            this.metrics.INP = entry.duration;
          }
        }
      });
      inpObserver.observe({ type: 'event', durationThreshold: 16, buffered: true });
    } catch (e) {
      console.warn("PerformanceObserver not fully supported", e);
    }
  },

  trackFPS() {
    let lastTime = performance.now();
    let frames = 0;
    
    const loop = () => {
      const now = performance.now();
      frames++;
      if (now > lastTime + 1000) {
        this.metrics.FPS = Math.round((frames * 1000) / (now - lastTime));
        frames = 0;
        lastTime = now;
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  },

  trackMemory() {
    setInterval(() => {
      if (performance.memory) {
        this.metrics.usedMemoryMB = Math.round(performance.memory.usedJSHeapSize / 1048576) + 'MB';
      } else {
        this.metrics.usedMemoryMB = 'N/A';
      }
    }, 5000);
  },

  logApiLatency(url, duration) {
    this.metrics.apiLatencies.push({ url, duration, timestamp: Date.now() });
    if (this.metrics.apiLatencies.length > 20) {
      this.metrics.apiLatencies.shift();
    }
  },

  setupConsoleReport() {
    setInterval(() => {
      const avgLatency = this.metrics.apiLatencies.length > 0 
        ? Math.round(this.metrics.apiLatencies.reduce((a, b) => a + b.duration, 0) / this.metrics.apiLatencies.length) + 'ms' 
        : 'N/A';
        
      console.log(
        `%c🏎️ KageWatch Core Web Vitals Analytics %c\n` +
        `• LCP: ${this.metrics.LCP || 'Calculating...'} (Target: <2.5s)\n` +
        `• FID: ${this.metrics.FID || 'Awaiting interaction...'} (Target: <100ms)\n` +
        `• CLS: ${this.metrics.CLS.toFixed(4)} (Target: <0.1)\n` +
        `• INP: ${this.metrics.INP}ms (Target: <200ms)\n` +
        `• FPS: ${this.metrics.FPS} (Target: 60 FPS)\n` +
        `• JS Memory: ${this.metrics.usedMemoryMB}\n` +
        `• Average AniList latency: ${avgLatency}`,
        "color: #e63950; font-weight: bold; font-size: 1.1rem;",
        "color: inherit; font-size: 0.9rem;"
      );
    }, 10000);
  }
};

KageWatchAnalytics.init();
