async function fetchScheduleData(isNewDate = false) {
  schedState.isLoading = true;
  
  const query = `
  query($page: Int, $start: Int, $end: Int) {
    Page(page: $page, perPage: 15) {
      pageInfo { hasNextPage }
      airingSchedules(airingAt_greater: $start, airingAt_lesser: $end, sort: TIME) {
        airingAt episode
        media { id title { romaji english } }
      }
    }
  }`;
  
  const vars = { page: schedState.page, start: schedState.start, end: schedState.end };
  const d = await alQ(query, vars);
  
  schedState.isLoading = false;
  const listContainer = document.getElementById('schedule-list-container');
  const moreBtn = document.getElementById('schedule-more-btn');
  
  if (!d || !d.Page || !d.Page.airingSchedules.length) {
    if (isNewDate) listContainer.innerHTML = '<div style="padding:40px 20px; text-align:center; color:var(--muted2);">No anime scheduled for this day.</div>';
    moreBtn.style.display = 'none';
    return;
  }
  
  schedState.hasNext = d.Page.pageInfo.hasNextPage;
  
  let html = d.Page.airingSchedules.map(item => {
    let dateObj = new Date(item.airingAt * 1000);
    let timeStr = dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    let title = getTitle(item.media.title);
    
    return `
      <div class="schedule-row">
        <span class="s-time">${timeStr}</span>
        <a class="s-title" href="/watch/${item.media.id}/${toSlug(title)}" onclick="event.preventDefault(); openWatchView(${item.media.id});">${title}</a>
        <a class="s-ep" href="/watch/${item.media.id}/${toSlug(title)}" onclick="event.preventDefault(); openWatchView(${item.media.id});">▶ Episode ${item.episode}</a>
      </div>
    `;
  }).join('');
  
  if (isNewDate) listContainer.innerHTML = html;
  else listContainer.innerHTML += html;
  
  if (schedState.hasNext) {
    moreBtn.style.display = 'block';
    moreBtn.onclick = () => {
      schedState.page++;
      moreBtn.textContent = 'Loading...';
      fetchScheduleData(false).then(() => {
        moreBtn.textContent = 'Show more';
      });
    };
  } else {
    moreBtn.style.display = 'none';
  }
}

