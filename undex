  // the normal Trending Now catalog. There is no separate/hardcoded hero
  // catalogue or manually selected hero artwork.
  const normalCatalogHero = tList
    .filter(a => a && (a.coverImage?.extraLarge || a.coverImage?.large || a.bannerImage))
    .slice(0,5);
  buildHero(normalCatalogHero);
  fillStrip('strip-trending', tList);
  fillStrip('strip-airing', airing?.Page?.media||[]);
  fillStrip('strip-finished', finished?.Page?.media||[]);
  fillStrip('strip-top', top?.Page?.media||[]);
  fillStrip('strip-action', action?.Page?.media||[]);
  fillStrip('strip-fantasy', fantasy?.Page?.media||[]);
  fillStrip('strip-adventure', adventure?.Page?.media||[]);
  fillStrip('strip-comedy', comedy?.Page?.media||[]);
  fillStrip('strip-drama', drama?.Page?.media||[]);
  fillStrip('strip-romance', romance?.Page?.media||[]);

  // Upcoming/Schedule catalog: One Piece gets first priority when AniList
  // provides its next airing time, followed by the normal schedule feed.
  const upcomingSchedules = upcoming?.Page?.airingSchedules || [];
  const opMedia = onePiece?.Media || onePiece?.data?.Media || null;
  const opNext = opMedia?.nextAiringEpisode;
  const opSchedule = (opMedia && opNext && opNext.airingAt)
    ? [{ airingAt: opNext.airingAt, episode: opNext.episode, media: opMedia }]
    : [];
  const nonOnePieceUpcoming = upcomingSchedules.filter(item => String(item?.media?.id) !== '21');
  fillUpcomingStrip('strip-upcoming', [...opSchedule, ...nonOnePieceUpcoming]);

  if (window.__animeNexusStartupReady) window.__animeNexusStartupReady();
  
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js')
        .then(reg => console.log('Service Worker registered successfully!', reg.scope))
        .catch(err => console.warn('Service Worker registration failed:', err));
    });
  }
  
  const savedNick = localStorage.getItem('party_nick');
  if (savedNick) {
    const el = document.getElementById('party-username');
    if (el) el.value = savedNick;
  }

  const urlRoom = urlParams.get('room');
  if (urlRoom) {
    switchRightTab('party');
    const el = document.getElementById('party-join-id');
    if (el) el.value = urlRoom;
    setTimeout(() => {
      joinParty();
    }, 1200);
  }







})();

// ── WATCH TOGETHER PEERJS INTEGRATION ──
let isPartyHost = false;
let isPartyGuest = false;
let partyPeer = null;
let partyConnections = [];
let hostConn = null;
let myPeerId = null;
let partyRoomId = null;
let hostNickname = localStorage.getItem('party_nick') || ("User_" + Math.floor(Math.random() * 1000));
let guestNicknames = {};

function switchRightTab(tab) {
  const epBtn = document.getElementById('tab-episodes-btn');
  const partyBtn = document.getElementById('tab-party-btn');
  const epCont = document.getElementById('tab-episodes-content');
  const partyCont = document.getElementById('tab-party-content');

  if (!epBtn || !partyBtn || !epCont || !partyCont) return;

  if (tab === 'episodes') {
    epBtn.classList.add('active');
    partyBtn.classList.remove('active');
    epCont.classList.add('active');
    partyCont.classList.remove('active');
  } else {
    epBtn.classList.remove('active');
    partyBtn.classList.add('active');
    epCont.classList.remove('active');
    partyCont.classList.add('active');
  }
}

async function initHostPeer(roomId) {
  await ensurePeerScript();
  partyPeer = new Peer(roomId);

  partyPeer.on('open', (id) => {
    partyRoomId = id;
    isPartyHost = true;
    isPartyGuest = false;
    window.isPartyHost = true;
    window.isPartyGuest = false;
    
    document.getElementById('party-setup').style.display = 'none';
    document.getElementById('party-room').style.display = 'flex';
    document.getElementById('party-room-id-label').textContent = 'ID: ' + id;
    
    const url = new URL(window.location.href);
    url.searchParams.set('room', id);
    window.history.replaceState({}, '', url.toString());

    appendPartySystemMessage("Room created. Share the link to invite friends!");
    updatePartyMembersUI();
  });

  partyPeer.on('connection', (conn) => {
    conn.on('open', () => {
      partyConnections.push(conn);
      conn.send({ type: 'REQ_NICKNAME' });
    });

    conn.on('data', (data) => {
      handlePartyData(conn, data);
    });

    conn.on('close', () => {
      partyConnections = partyConnections.filter(c => c !== conn);
      const guestNick = guestNicknames[conn.peer] || conn.peer;
      appendPartySystemMessage(`${guestNick} left the room.`);
      delete guestNicknames[conn.peer];
      updatePartyMembersUI();
      broadcastToParty({ type: 'SYSTEM', message: `${guestNick} left the room.` });
    });
  });

  partyPeer.on('error', (err) => {
    console.error(err);
    if (err.type === 'unavailable-id') {
      showToast("Room ID taken. Try again.");
    } else {
      showToast("Connection Error: " + err.message);
    }
  });
}

async function initGuestPeer(roomId) {
  await ensurePeerScript();
  partyPeer = new Peer();

  partyPeer.on('open', (myId) => {
    myPeerId = myId;
    isPartyHost = false;
    isPartyGuest = true;
    window.isPartyHost = false;
    window.isPartyGuest = true;

    hostConn = partyPeer.connect(roomId);

    hostConn.on('open', () => {
      partyRoomId = roomId;
      document.getElementById('party-setup').style.display = 'none';
      document.getElementById('party-room').style.display = 'flex';
      document.getElementById('party-room-id-label').textContent = 'ID: ' + roomId;
      
      const url = new URL(window.location.href);
      url.searchParams.set('room', roomId);
      window.history.replaceState({}, '', url.toString());

      appendPartySystemMessage("Connected to room! Syncing...");
      hostConn.send({ type: 'NICKNAME', nickname: hostNickname });
    });

    hostConn.on('data', (data) => {
      handlePartyData(hostConn, data);
    });

    hostConn.on('close', () => {
      appendPartySystemMessage("Disconnected from room.");
      showToast("Room disconnected.");
      leaveParty();
    });
  });

  partyPeer.on('error', (err) => {
    console.error(err);
    showToast("Could not join room. Check ID.");
  });
}

function handlePartyData(conn, data) {
  if (data.type === 'REQ_NICKNAME') {
    conn.send({ type: 'NICKNAME', nickname: hostNickname });
  }
  else if (data.type === 'NICKNAME') {
    guestNicknames[conn.peer] = data.nickname;
    appendPartySystemMessage(`${data.nickname} joined the watch party!`);
    updatePartyMembersUI();
    
    if (isPartyHost) {
      conn.send({
        type: 'STATE',
        animeId: state.animeId,
        ep: state.currentEp,
        isPlaying: window.playerInstance && !window.playerInstance.paused,
        time: window.playerInstance ? window.playerInstance.currentTime : 0
      });
      broadcastToParty({ type: 'SYSTEM', message: `${data.nickname} joined.` });
    }
  }
  else if (data.type === 'MEMBERS') {
    const list = data.members;
    const membersEl = document.getElementById('party-members');
    if (membersEl) membersEl.textContent = 'Members: ' + list.join(', ');
  }
  else if (data.type === 'CHAT') {
    appendPartyChatMessage(data.sender, data.text);
    if (isPartyHost) {
      partyConnections.forEach(c => {
        if (c.open && c.peer !== conn.peer) {
          c.send({ type: 'CHAT', sender: data.sender, text: data.text });
        }
      });
    }
  }
  else if (data.type === 'SYSTEM') {
    appendPartySystemMessage(data.message);
  }
  else if (data.type === 'STATE' || data.type === 'SYNC') {
    syncPlayerWithHost(data);
  }
}

function broadcastToParty(data) {
  if (isPartyHost && partyConnections.length > 0) {
    partyConnections.forEach(conn => {
      if (conn.open) conn.send(data);
    });
  }
}

function syncPlayerWithHost(data) {
  if (state.animeId !== data.animeId || state.currentEp !== data.ep) {
    window.pendingPartySync = { time: data.time, isPlaying: data.isPlaying };
    if (document.getElementById('watch-view').classList.contains('active')) {
      if (state.animeId === data.animeId) {
        playEp(data.ep);
      } else {
        openWatchView(data.animeId).then(() => {
          playEp(data.ep);
        });
      }
    } else {
      openWatchView(data.animeId).then(() => {
        playEp(data.ep);
      });
    }
    return;
  }

  if (!window.playerInstance) return;
  
  window.isSyncing = true;
  if (Math.abs(window.playerInstance.currentTime - data.time) > 3) {
    window.playerInstance.currentTime = data.time;
  }
  if (data.isPlaying && window.playerInstance.paused) {
    window.playerInstance.play().catch(() => {});
  } else if (!data.isPlaying && !window.playerInstance.paused) {
    window.playerInstance.pause();
  }
  setTimeout(() => { window.isSyncing = false; }, 600);
}

function setupPartyPlayerListeners(playerInstance) {
  window.playerInstance = playerInstance;
  
  if (window.pendingPartySync) {
    const sync = window.pendingPartySync;
    window.pendingPartySync = null;
    window.isSyncing = true;
    playerInstance.currentTime = sync.time;
    if (sync.isPlaying) {
      playerInstance.play().catch(() => {});
    } else {
      playerInstance.pause();
    }
    setTimeout(() => { window.isSyncing = false; }, 500);
  }

  playerInstance.on('play', () => {
    if (isPartyHost && !window.isSyncing) {
      broadcastToParty({
        type: 'SYNC',
        animeId: state.animeId,
        ep: state.currentEp,
        isPlaying: true,
        time: playerInstance.currentTime
      });
    }
  });

  playerInstance.on('pause', () => {
    if (isPartyHost && !window.isSyncing) {
      broadcastToParty({
        type: 'SYNC',
        animeId: state.animeId,
        ep: state.currentEp,
        isPlaying: false,
        time: playerInstance.currentTime
      });
    }
  });

  playerInstance.on('seeked', () => {
    if (isPartyHost && !window.isSyncing) {
      broadcastToParty({
        type: 'SYNC',
        animeId: state.animeId,
        ep: state.currentEp,
        isPlaying: !playerInstance.paused,
        time: playerInstance.currentTime
      });
    }
  });
}

function createParty() {
  const nickInput = document.getElementById('party-username');
  let nick = nickInput.value.trim();
  if (!nick) {
    nick = "Host_" + Math.floor(1000 + Math.random() * 9000);
    nickInput.value = nick;
  }
  hostNickname = nick;
  localStorage.setItem('party_nick', nick);

  const roomId = 'KW-' + Math.random().toString(36).substring(2, 8).toUpperCase();
  initHostPeer(roomId);
}

function joinParty() {
  const nickInput = document.getElementById('party-username');
  let nick = nickInput.value.trim();
  if (!nick) {
    nick = "Guest_" + Math.floor(1000 + Math.random() * 9000);
    nickInput.value = nick;
  }
  hostNickname = nick;
  localStorage.setItem('party_nick', nick);

  const roomIdInput = document.getElementById('party-join-id');
  const roomId = roomIdInput.value.trim().toUpperCase();
  if (!roomId) {
    showToast("Please enter a Room ID");
    return;
  }
  initGuestPeer(roomId);
}

function leaveParty() {
  if (partyPeer) partyPeer.destroy();
  isPartyHost = false;
  isPartyGuest = false;
  window.isPartyHost = false;
  window.isPartyGuest = false;
  partyPeer = null;
  partyConnections = [];
  hostConn = null;
  partyRoomId = null;
  guestNicknames = {};
  
  document.getElementById('party-setup').style.display = 'block';
  document.getElementById('party-room').style.display = 'none';
  document.getElementById('party-members').textContent = 'Members: Loading...';
  document.getElementById('party-chat-messages').innerHTML = '<div style="color: var(--muted); text-align: center;">Welcome to the watch party chat!</div>';

  const url = new URL(window.location.href);
  url.searchParams.delete('room');
  window.history.replaceState({}, '', url.toString());

  showToast("Left room.");
}

function copyPartyLink() {
  navigator.clipboard.writeText(window.location.href).then(() => {
    showToast("Link copied to clipboard!");
  }).catch(() => {
    showToast("Failed to copy link.");
  });
}

function sendPartyMessage() {
  const input = document.getElementById('party-chat-input');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';

  if (isPartyHost) {
    appendPartyChatMessage(hostNickname, text);
    broadcastToParty({ type: 'CHAT', sender: hostNickname, text: text });
  } else if (isPartyGuest && hostConn && hostConn.open) {
    appendPartyChatMessage(hostNickname, text);
    hostConn.send({ type: 'CHAT', sender: hostNickname, text: text });
  }
}

function appendPartyChatMessage(sender, text) {
  const container = document.getElementById('party-chat-messages');
  if (!container) return;
  
  const isMe = sender === hostNickname;
  const bubble = document.createElement('div');
  bubble.style.display = 'flex';
  bubble.style.flexDirection = 'column';
  bubble.style.alignItems = isMe ? 'flex-end' : 'flex-start';
  bubble.style.margin = '8px 0';
  bubble.style.width = '100%';
  
  bubble.innerHTML = `
    <span style="font-size: 0.65rem; color: var(--muted2); margin-bottom: 2px; font-weight: 700; padding: 0 4px;">${escapeHTML(sender)}</span>
    <div style="
      background: ${isMe ? 'var(--accent)' : 'var(--card)'}; 
      color: #fff; 
      padding: 8px 12px; 
      border-radius: 12px; 
      border-bottom-${isMe ? 'right' : 'left'}-radius: 2px;
      max-width: 85%;
      word-break: break-word;
      font-size: 0.78rem;
      border: 1px solid ${isMe ? 'var(--accent)' : 'var(--border)'};
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      line-height: 1.4;
    ">
      ${escapeHTML(text)}
    </div>
  `;
  container.appendChild(bubble);
  container.scrollTop = container.scrollHeight;
}

function appendPartySystemMessage(text) {
  const container = document.getElementById('party-chat-messages');
  if (!container) return;
  const msg = document.createElement('div');
  msg.style.margin = '4px 0';
  msg.style.color = 'var(--muted2)';
  msg.style.fontStyle = 'italic';
  msg.textContent = text;
  container.appendChild(msg);
  container.scrollTop = container.scrollHeight;
}

function updatePartyMembersUI() {
  const membersEl = document.getElementById('party-members');
  if (!membersEl) return;
  const list = [hostNickname, ...Object.values(guestNicknames)];
  membersEl.textContent = 'Members: ' + list.join(', ');
  
  if (isPartyHost) {
    broadcastToParty({ type: 'MEMBERS', members: list });
  }
}

function escapeHTML(str) {
  return str.replace(/[&<>'"]/g, 
    tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
  );
}

