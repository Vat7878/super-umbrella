function goHero(i){
  document.querySelectorAll('.hero-slide').forEach((s,j)=>{
    const isActive = (j === i);
    s.classList.toggle('active', isActive);
    if (isActive) {
      // Load lazy images/backgrounds for this slide
      const bg = s.querySelector('.hero-bg');
      if (bg && bg.dataset.bg) {
        bg.style.backgroundImage = `url('${bg.dataset.bg}')`;
        bg.style.setProperty('--hero-image', `url('${bg.dataset.bg}')`);
        delete bg.dataset.bg;
      }
      const cover = s.querySelector('.hero-cover');
      if (cover && cover.dataset.src) {
        cover.src = cover.dataset.src;
        delete cover.dataset.src;
      }
      
      // Preload next slide images
      const nextIdx = (i + 1) % heroAnimes.length;
      const nextSlide = document.querySelectorAll('.hero-slide')[nextIdx];
      if (nextSlide) {
        const nBg = nextSlide.querySelector('.hero-bg');
        if (nBg && nBg.dataset.bg) {
          nBg.style.backgroundImage = `url('${nBg.dataset.bg}')`;
          nBg.style.setProperty('--hero-image', `url('${nBg.dataset.bg}')`);
          delete nBg.dataset.bg;
        }
        const nCover = nextSlide.querySelector('.hero-cover');
        if (nCover && nCover.dataset.src) {
          nCover.src = nCover.dataset.src;
          delete nCover.dataset.src;
        }
      }
    }
  });
  document.querySelectorAll('.hero-dot').forEach((d,j)=>d.classList.toggle('active',j===i));
  heroIdx=i;
}
