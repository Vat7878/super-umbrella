      const stream = streamData?.streams?.find(s => s.server === 'VidPlay-1' && s.type === 'hls')
                  || streamData?.streams?.find(s => s.type === 'hls' && s.default)
                  || streamData?.streams?.find(s => s.type === 'hls');
      if (stream && stream.url) {
        const PROXY_BASE = "https://kagewatch-kagewatch-proxy.hf.space/proxy"; // VIP stream proxy
        const referer = stream.referer || "";
        const proxyUrl = `${PROXY_BASE}?url=${encodeURIComponent(stream.url)}&referer=${encodeURIComponent(referer)}`;
        fetch(proxyUrl, { method: 'HEAD' }).catch(() => {});
      }
    })
    .catch(() => {});
}

function buildSubtitleTracks(subtitles, referer, lang) {
  if (!subtitles?.length) return '';
  const PROXY_BASE = "https://kagewatch-kagewatch-proxy.hf.space/proxy"; // VIP stream proxy

  const validSubs = subtitles.filter(s => s.file && (s.format === 'vtt' || s.file.includes('.vtt')));

  validSubs.sort((a, b) => {
      let isAEng = a.label?.toLowerCase().includes('english') ? 1 : 0;
      let isBEng = b.label?.toLowerCase().includes('english') ? 1 : 0;
      return isBEng - isAEng;
  });

  let engAdded = false;

  return validSubs.map(sub => {
      const isEng = sub.label?.toLowerCase().includes('english') || sub.language?.toLowerCase() === 'en';
      let isDef = '';
      
      if (isEng && !engAdded) {
          isDef = 'default';
          engAdded = true;
      }

      const proxiedSub = `${PROXY_BASE}?url=${encodeURIComponent(sub.file)}&referer=${encodeURIComponent(referer)}`;
      return `<track kind="captions" label="${sub.label || 'Sub'}" src="${proxiedSub}" srclang="${sub.language || 'en'}" ${isDef}>`;
  }).join('\n');
}

