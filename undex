<script>
(()=>{
  let appReady=false, windowReady=document.readyState==='complete', startupMinTime=false;
  const hide=()=>{
    if(!appReady || !windowReady || !startupMinTime) return;
    const s=document.getElementById('anexus-startup');
    if(!s) return;
    s.classList.add('ready');
    setTimeout(()=>s.remove(),420);
  };
  setTimeout(()=>{startupMinTime=true;hide()},1800);
  /* Safety fallback: never trap users behind the splash if an optional API/catalog fails. */
  setTimeout(()=>{
    const s=document.getElementById('anexus-startup');
    if(s){ s.classList.add('ready'); setTimeout(()=>s.remove(),420); }
  },6500);
  window.__animeNexusStartupReady=()=>{appReady=true;hide()};
  window.addEventListener('load',()=>{windowReady=true;hide()},{once:true});
})();
