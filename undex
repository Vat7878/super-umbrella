let ttTimer = null;
function getAgeRating(genres) {
  if (!genres) return 'PG-13';
  if (genres.includes('Ecchi') || genres.includes('Horror') || genres.includes('Gore')) return 'R+';
  if (genres.includes('Kids')) return 'PG';
  return 'PG-13';
}

function showTooltip(cardEl, a) {
  clearTimeout(ttTimer);
  const tt = document.getElementById('global-tooltip');
  
  const score = a.averageScore ? (a.averageScore/10).toFixed(1) : 'N/A';
  const year = a.startDate?.year || 'TBA';
  const format = a.format ? a.format.replace('_', ' ') : 'TV';
  const eps = a.episodes || '?';
  const desc = a.description ? a.description.replace(/<[^>]*>/g,'') : 'No synopsis available.';
  const genresArray = a.genres || [];
  const genres = genresArray.slice(0,3).join(', ');
  const rating = getAgeRating(genresArray);
  
  tt.innerHTML = `
    <div class="tt-title">${getTitle(a.title)}</div>
    <div class="tt-meta">
      <span class="score">⭐ ${score}</span>
      <span class="badge">${rating}</span>
      <span class="badge">HD</span>
      <span class="badge" style="border-color:var(--accent2); color:var(--accent2)">CC ${eps}</span>
      <span class="badge">${format}</span>
    </div>
    <div class="tt-desc">${desc}</div>
    <div class="tt-info">
      <div><span>Release:</span> ${year}</div>
      <div><span>Status:</span> ${a.status}</div>
      <div><span>Genres:</span> ${genres}</div>
    </div>
    <div class="tt-actions">
      <a href="/watch/${a.id}/${toSlug(getTitle(a.title))}" class="tt-btn-watch" onclick="event.preventDefault(); hideTooltip(); openWatchView(${a.id});">▶ Watch Now</a>
      <button class="tt-btn-add" onclick="Store.toggleFav(${JSON.stringify(a).replace(/"/g, '&quot;')})">+</button>
    </div>
  `;

  const rect = cardEl.getBoundingClientRect();
  let leftPos = rect.right - 10;
  let topPos = rect.top + (rect.height / 2) - 50;

  if (topPos < 80) topPos = 100;
  if (topPos + 320 > window.innerHeight) topPos = window.innerHeight - 330;
  if (leftPos + 340 > window.innerWidth) leftPos = rect.left - 355;
  if (topPos + 380 > window.innerHeight) topPos = rect.top - 200;

  tt.style.left = leftPos + 'px';
  tt.style.top = topPos + 'px';
  tt.classList.add('show');
}

function hideTooltip() {
  ttTimer = setTimeout(() => {
    document.getElementById('global-tooltip').classList.remove('show');
  }, 200); 
}

