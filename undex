function getAnimeCover(a) {
  return String(a?.id) === '21' ? ONE_PIECE_CUSTOM_COVER : (a?.coverImage?.extraLarge || a?.coverImage?.large || '');
}
/* Custom main-hero artwork: these use the exact uploaded key art requested by the site owner.
   Catalog cards remain unchanged; only the homepage Spotlight artwork is overridden for these IDs. */
const CUSTOM_HERO_ARTWORKS = {
    201514: 'data:image/jpeg;base64,',
    210031: 'data:image/jpeg;base64,',
    195600: 'data:image/jpeg;base64,',
    178789: 'data:image/jpeg;base64,'
