<script id="anexus-player-final-interaction-authoritative">
(function(){
  'use strict';
  let suppressFullscreenClickUntil=0;

  function getPlayerFromButton(btn){
    const el=btn?.closest?.('.plyr');
    return el?.plyr || window.activePlyrInstance || window.player || null;
  }

  function handlePlyrFullscreen(e){
    const btn=e.target?.closest?.('.plyr__control[data-plyr="fullscreen"]');
    if(!btn) return;
    const player=getPlayerFromButton(btn);
    if(!player) return;

    // One gesture = one toggle. Do it during pointerdown and suppress Plyr's
    // own later click so it cannot toggle back immediately.
    if(e.type==='pointerdown'){
      if(e.pointerType==='mouse' && e.button!==0) return;
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();
      suppressFullscreenClickUntil=performance.now()+700;
      try{
        const inAnimeNexusFullscreen =
          document.body.classList.contains('anexus-player-fullscreen') ||
          document.documentElement.classList.contains('anexus-player-fullscreen') ||
          player.elements?.container?.classList.contains('anexus-web-fullscreen');

        // In the AnimeNexus fullscreen player, the corner button is the
        // player's MINIMIZE control: leave playback and return to the
        // current anime-specific hero/detail page. Do not merely exit
        // fullscreen and leave the watch page underneath it.
        if(inAnimeNexusFullscreen){
          try{ minimizePlayerToOptions(); }
          catch(_){ try{ backToAnimeLanding(); }catch(__){} }
        }else{
          enterAnexusWebFullscreen(player);
        }
      }catch(_){ }
      return;
    }

    if(e.type==='click' && performance.now()<suppressFullscreenClickUntil){
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();
    }
  }

  // Capture at document level so this wins over Plyr's target listener on iOS,
  // iPadOS, Android and desktop.
  document.addEventListener('pointerdown',handlePlyrFullscreen,true);
  document.addEventListener('click',handlePlyrFullscreen,true);

  function attachCenter(player){
    const box=player?.elements?.container;
    if(!box || box.dataset.anexusCenterAuthoritative==='1') return;
    box.dataset.anexusCenterAuthoritative='1';

    const feedback=document.createElement('div');
    feedback.className='anexus-center-play-feedback';
    feedback.setAttribute('aria-hidden','true');
    box.appendChild(feedback);
    let timer=0;

    function showFeedback(){
      feedback.textContent=player.playing ? '❚❚' : '▶';
      feedback.classList.add('show');
      clearTimeout(timer);
      timer=setTimeout(()=>feedback.classList.remove('show'),550);
    }

    function inCenter(e){
      const r=box.getBoundingClientRect();
      if(!r.width || !r.height) return false;
      const x=e.clientX-r.left, y=e.clientY-r.top;
      return x>=r.width*.25 && x<=r.width*.75 && y>=r.height*.25 && y<=r.height*.75;
    }

    // The media itself gets exactly one toggle. Controls/settings/menu never do.
    box.addEventListener('pointerup',function(e){
      if(e.pointerType==='mouse' && e.button!==0) return;
      if(e.target?.closest?.('.plyr__controls,.plyr__control,.plyr__menu,.plyr__tooltip,.anexus-player-menu,.anexus-center-play-feedback')) return;
      if(!inCenter(e)) return;
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();
      try{
        player.togglePlay();
        // Wait for Plyr/media state to update before choosing the icon.
        setTimeout(showFeedback,20);
      }catch(_){ }
    },true);

    // iOS/Android can synthesize a click after pointerup. Swallow that click
    // only when it lands in the media center, preventing a second toggle.
    box.addEventListener('click',function(e){
      if(e.target?.closest?.('.plyr__controls,.plyr__control,.plyr__menu,.plyr__tooltip,.anexus-player-menu,.anexus-center-play-feedback')) return;
      if(!inCenter(e)) return;
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();
    },true);
  }

  function scan(){
    const seen=new Set();
    const players=[];
    if(window.activePlyrInstance) players.push(window.activePlyrInstance);
    if(window.player) players.push(window.player);
    document.querySelectorAll('.plyr').forEach(el=>{ if(el.plyr) players.push(el.plyr); });
    players.forEach(p=>{
      if(!p || seen.has(p)) return;
      seen.add(p);
      try{ attachCenter(p); }catch(_){ }
    });
  }
  scan();
  const observer=new MutationObserver(scan);
  observer.observe(document.documentElement,{subtree:true,childList:true});
  setTimeout(()=>observer.disconnect(),120000);
  setInterval(scan,1000);
})();
</script>
