    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/(^-|-$)/g, '');
}

const memoryCache = new Map();
const pendingRequests = new Map();

function pruneLocalStorageCache() {
  try {
    const keys = [];
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.startsWith('al_cache_')) {
        keys.push(key);
      }
    }
    if (keys.length > 150) {
      const parsed = keys.map(k => {
        try {
          const item = JSON.parse(localStorage.getItem(k));
          return { key: k, timestamp: item.timestamp || 0 };
        } catch {
          return { key: k, timestamp: 0 };
        }
      });
      parsed.sort((a, b) => a.timestamp - b.timestamp);
      for (let i = 0; i < 75; i++) {
        localStorage.removeItem(parsed[i].key);
      }
    }
  } catch (e) {
    console.warn("Cache pruning failed", e);
  }
}

async function fetchWithRetry(query, vars, cacheKey, isBackground = false, abortSignal = null, retries = 3, delay = 1000) {
  for (let attempt = 1; attempt <= retries; attempt++) {
    try {
      const startTime = performance.now();
      const r = await fetch(AL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, variables: vars }),
        signal: abortSignal
      });
      
      if (r.status === 429 || r.status === 403) {
        throw new Error(`API Status Code: ${r.status}`);
      }

      if (!r.ok) {
        throw new Error(`HTTP Error: ${r.statusText}`);
      }

      const j = await r.json();
      if (j.errors) {
        throw new Error(j.errors[0]?.message || "GraphQL Error");
      }

      const data = j.data;
      if (data) {
        const duration = performance.now() - startTime;
        if (typeof KageWatchAnalytics !== 'undefined') {
          KageWatchAnalytics.logApiLatency('AniList GraphQL API', duration);
        }
        memoryCache.set(cacheKey, { timestamp: Date.now(), data });
        try {
          pruneLocalStorageCache();
          localStorage.setItem(cacheKey, JSON.stringify({ timestamp: Date.now(), data }));
        } catch (e) {}
        return data;
      }
    } catch (e) {
      if (e.name === 'AbortError') {
        throw e;
      }
      if (attempt === retries) {
        console.warn(`Request failed after ${retries} attempts:`, e);
        if (isBackground) return null;
        try {
          const fallback = localStorage.getItem(cacheKey);
          if (fallback) {
            return JSON.parse(fallback).data;
          }
        } catch {}
        return null;
      }
      await new Promise(res => setTimeout(res, delay * attempt));
    }
  }
}

async function alQ(query, vars = {}, abortSignal = null) {
  const cacheKey = 'al_cache_' + btoa(unescape(encodeURIComponent(query + JSON.stringify(vars))));
  const now = Date.now();
  
  if (memoryCache.has(cacheKey)) {
    const { timestamp, data } = memoryCache.get(cacheKey);
    if (now - timestamp < 300000) {
      return data;
    }
    if (now - timestamp < 3600000) {
      fetchWithRetry(query, vars, cacheKey, true, abortSignal).catch(() => {});
      return data;
    }
  }

  try {
    const cachedData = localStorage.getItem(cacheKey);
    if (cachedData) {
      const { timestamp, data } = JSON.parse(cachedData);
      memoryCache.set(cacheKey, { timestamp, data });
      if (now - timestamp < 300000) {
        return data;
      }
      if (now - timestamp < 3600000) {
        fetchWithRetry(query, vars, cacheKey, true, abortSignal).catch(() => {});
        return data;
      }
    }
  } catch (e) {}

  if (pendingRequests.has(cacheKey)) {
    return pendingRequests.get(cacheKey);
  }

  const fetchPromise = fetchWithRetry(query, vars, cacheKey, false, abortSignal);
  pendingRequests.set(cacheKey, fetchPromise);

  try {
    const data = await fetchPromise;
    return data;
  } finally {
    pendingRequests.delete(cacheKey);
  }
}

