<style>
:root {
  --bg: #06060f;
  --surface: #0e0e1c;
  --card: #111120;
  --card2: #181828;
  --border: rgba(255,255,255,0.06);
  --border2: rgba(255,255,255,0.13);
  --accent: #e63950;
  --accent2: #ff6b35;
  --purple: #7c4dff;
  --text: #ededf8;
  --muted: #52526e;
  --muted2: #8888aa;
  --glow: rgba(230,57,80,0.22);
  --r: 11px;
  --rl: 16px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;width:100%;min-height:100%;overflow-x:hidden;overscroll-behavior-x:none;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100dvh;width:100%;max-width:100vw;overflow-x:hidden;overscroll-behavior-x:none;display:flex;flex-direction:column;padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right);}

/* iPad/iPhone viewport lock: use the exact dynamic viewport without allowing
   the whole document to pan sideways. Intentional inner scrollers remain scrollable. */
html,body{touch-action:pan-y;}
img,video,iframe{max-width:100%;}


/* --- SEO FRIENDLY HIDDEN TEXT --- */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

/* --- AMBIENT DYNAMIC BACKGROUND --- */
#ambient-bg { position: fixed; inset: -50px; z-index: -1; background-size: cover; background-position: center top; filter: blur(25px) brightness(0.15); opacity: 0; transition: opacity 0.6s ease, background-image 0.6s ease; pointer-events: none; }
#ambient-bg.active { opacity: 1; }

/* Premium Custom Scrollbar */
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--muted);border-radius:10px;transition:background 0.3s}
::-webkit-scrollbar-thumb:hover{background:var(--accent)}

/* --- 🚀 PLYR CUSTOM THEME --- */
.plyr {
    --plyr-color-main: var(--accent); 
    --plyr-video-control-color-hover: #fff;
    --plyr-video-control-background-hover: var(--accent);
    --plyr-menu-background: var(--card); 
    --plyr-menu-color: var(--text);
    --plyr-tooltip-background: var(--card2);
    --plyr-tooltip-color: var(--text);
    font-family: 'DM Sans', sans-serif;
    width: 100% !important;
    height: 100% !important;
}
.plyr--video .plyr__control.plyr__tab-focus,
.plyr--video .plyr__control:hover,
.plyr--video .plyr__control[aria-expanded=true] { background: var(--accent) !important; }
.plyr__control--overlaid { background: var(--accent) !important; }
.plyr__menu__container .plyr__control[role=menuitemradio][aria-checked=true]::before { background: var(--accent) !important; }
.plyr--full-ui input[type=range] { color: var(--accent) !important; }

/* --- FIX FOR 4:3 OLD ANIME CROPPING --- */
.player-container video,
.plyr video,
.plyr__video-wrapper video {
    object-fit: contain !important;
    width: 100% !important;
    height: 100% !important;
}

/* --- AnimeNexus NATIVE PLAYER CSS --- */
#skip-btn {
  display: none;
  position: absolute;
  bottom: 80px;
  right: 20px;
  background-color: rgba(230, 57, 80, 0.9);
  color: white;
  border: none;
  padding: 10px 18px;
  cursor: pointer;
  border-radius: 6px;
  font-size: 14px;
  font-weight: bold;
  transition: 0.3s;
  z-index: 100;
  box-shadow: 0 4px 15px rgba(0,0,0,0.5);
}
#skip-btn:hover { background-color: white; color: black; }
.player-loading { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:#000; color:var(--text); font-size:1.1rem; z-index:10; }

/* --- IN-PLAYER AUTO NEXT BUTTON --- */
#auto-next-btn {
  display: none;
  position: absolute;
  bottom: 90px;
  right: 25px;
  background: rgba(14, 14, 28, 0.85);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
  color: white;
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
  z-index: 9999;
  box-shadow: 0 10px 30px rgba(0,0,0,0.8);
  transition: all 0.3s ease;
}
#auto-next-btn:hover { background: var(--accent); border-color: var(--accent); transform: scale(1.05); }
#auto-next-btn.show { display: flex; align-items: center; gap: 12px; animation: slideInRight 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
@keyframes slideInRight { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
.anb-icon { width: 28px; height: 28px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.anb-info { display: flex; flex-direction: column; text-align: left; }
.anb-label { font-size: 0.7rem; color: var(--muted2); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
.anb-time { font-size: 1.1rem; font-family: 'Bebas Neue', sans-serif; letter-spacing: 1px; color: #fff; line-height: 1.1; }

/* --- HEADER --- */
header{position:fixed;top:0;left:0;right:0;z-index:300;padding:0 44px;height:70px;display:flex;align-items:center;gap:35px;transition:all .4s;background:linear-gradient(to bottom, rgba(6,6,15,0.9) 0%, transparent 100%);}
header.scrolled{background:rgba(6,6,15,0.85);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1px solid var(--border);height:62px;}

.logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 2rem;
  font-weight: normal;
  letter-spacing: 4px;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  cursor: pointer;
  margin: 0;
  text-decoration: none;
}

nav{display:flex;gap:8px;flex:1;position:relative;}
nav a{padding:8px 16px;color:var(--muted2);font-size:0.85rem;font-weight:600;border-radius:8px;cursor:pointer;transition:color .3s;text-decoration:none;position:relative;z-index:2;}
nav a:hover, nav a.active{color:var(--text);}
.nav-indicator{position:absolute;bottom:0;height:100%;background:rgba(255,255,255,0.08);border-radius:8px;transition:all 0.4s cubic-bezier(0.34,1.3,0.64,1);z-index:1;}

.header-right{display:flex;align-items:center;gap:14px;flex-shrink:0}

/* TITLE TOGGLE BUTTON */
.lang-toggle { cursor: pointer; font-size: 0.75rem; font-weight: 700; background: rgba(255,255,255,0.08); border: 1px solid var(--border); padding: 6px 12px; border-radius: 6px; color: var(--text); transition: all 0.3s; display: flex; align-items: center; gap: 6px; }
.lang-toggle:hover { background: var(--accent); border-color: var(--accent); }
.lang-toggle span { color: var(--muted2); }
.lang-toggle.en span.en { color: #fff; }
.lang-toggle.jp span.jp { color: #fff; }

.search-pill{display:flex;align-items:center;gap:8px;padding:6px 10px 6px 16px;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:24px;transition:all .3s;}
.search-pill input{background:none;border:none;outline:none;color:var(--text);font-family:inherit;font-size:0.85rem;width:160px;}
.search-pill input::placeholder{color:var(--muted)}
.search-pill:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px var(--glow);background:rgba(230,57,80,0.04)}
.shortcut-hint{font-size:0.65rem;font-weight:700;color:var(--muted);background:var(--card2);padding:2px 6px;border-radius:4px;border:1px solid var(--border2);letter-spacing:1px; flex-shrink: 0;}

.filter-btn-inside { margin-left: 2px; padding: 6px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; color: var(--muted); }
.filter-btn-inside:hover { color: var(--text); background: rgba(255,255,255,0.1); }

.icon-btn{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,0.05);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .3s;color:var(--muted2);font-size:0.9rem;}
.icon-btn:hover{background:var(--accent);border-color:var(--accent);color:#fff;transform:translateY(-2px);box-shadow:0 6px 16px var(--glow)}
.icon-btn.active-heart{color:#e63950;background:rgba(230,57,80,0.1);border-color:#e63950;}

/* --- PREMIUM GLOBAL HOVER TOOLTIP --- */
#global-tooltip { position: fixed; width: 340px; background: rgba(14, 14, 28, 0.85); backdrop-filter: blur(20px); border: 1px solid var(--border2); border-radius: 12px; padding: 20px; z-index: 1000; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.3s ease, transform 0.3s ease; transform: translateY(10px); box-shadow: 0 20px 40px rgba(0,0,0,0.8); display: flex; flex-direction: column; gap: 12px; }
#global-tooltip.show { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0); }
.tt-title { font-size: 1.1rem; font-weight: 700; color: #fff; line-height: 1.3; }
.tt-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 0.75rem; font-weight: 700; color: var(--muted2); }
.tt-meta .score { color: #ffd700; display: flex; align-items: center; gap: 4px; }
.tt-meta .badge { background: var(--card2); border: 1px solid var(--border); padding: 2px 6px; border-radius: 4px; color: var(--text); }
.tt-desc { font-size: 0.8rem; color: var(--muted2); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.tt-info { font-size: 0.75rem; color: var(--text); line-height: 1.6; }
.tt-info span { color: var(--muted2); font-weight: 600; width: 65px; display: inline-block; }
.tt-actions { display: flex; gap: 10px; margin-top: 4px; }
.tt-btn-watch { flex: 1; background: var(--accent); color: #fff; border: none; padding: 10px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none; }
.tt-btn-watch:hover { background: #c92d42; transform: translateY(-2px); }
.tt-btn-add { width: 40px; height: 40px; background: rgba(255,255,255,0.1); border: 1px solid var(--border); color: #fff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; cursor: pointer; transition: 0.2s; }
.tt-btn-add:hover { background: #fff; color: #000; }
@media (max-width: 1024px) { #global-tooltip { display: none !important; } }

/* --- VIEWS LOGIC --- */
.view { display: none; animation: fadeIn 0.4s ease; flex: 1; }
.view.active { display: block; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

/* --- PREMIUM HERO --- */
#hero{position:relative;width:100%;height:min(74svh,760px);min-height:540px;overflow:hidden;margin-bottom:0;background:#000;}
#hero::before, #hero::after{content:'';position:absolute;left:0;right:0;height:24px;background:#000;z-index:10;pointer-events:none;}
#hero::before{top:0;} #hero::after{bottom:0;}
.hero-slide{position:absolute;inset:0;opacity:0;transition:opacity .8s ease;pointer-events:none;overflow:hidden;}
.hero-slide.active{opacity:1;pointer-events:auto}
.hero-bg{position:absolute;inset:0;width:100%;height:100%;background-size:cover;background-repeat:no-repeat;background-position:center center;filter:brightness(0.4);transform:none !important;transition:none;}
.hero-grad{position:absolute;inset:0;background:linear-gradient(to right,rgba(6,6,15,0.95) 0%,rgba(6,6,15,0.7) 45%,rgba(6,6,15,0.1) 100%),linear-gradient(to top,rgba(6,6,15,1) 0%,transparent 30%);}
.hero-content{position:relative;z-index:2;height:100%;display:flex;align-items:center;padding:0 60px;gap:0;transform:translateY(10px);transition:transform 0.8s cubic-bezier(0.34,1.3,0.64,1);opacity:0;}
.hero-slide.active .hero-content{transform:translateY(0);opacity:1;}
.hero-left{max-width:550px;flex:1}
.hero-eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:0.75rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--accent);margin-bottom:16px;}
.hero-eyebrow .pulse{width:8px;height:8px;border-radius:50%;background:var(--accent);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 var(--glow)}50%{box-shadow:0 0 0 6px transparent}}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:4.2rem;letter-spacing:2px;line-height:0.9;margin-bottom:18px;text-shadow: 0 10px 30px rgba(0,0,0,0.8);}
.hero-genres{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.hero-genre{font-size:0.75rem;font-weight:600;padding:4px 12px;border-radius:6px;background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.15);backdrop-filter:blur(4px);}
.hero-desc{font-size:0.9rem;color:var(--muted2);line-height:1.7;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:28px;}
.btn-watch{display:flex;align-items:center;gap:10px;padding:14px 32px;background:var(--accent);color:#fff;border:none;border-radius:10px;font-family:inherit;font-weight:700;font-size:0.9rem;cursor:pointer;transition:all .3s;box-shadow:0 8px 24px var(--glow);text-decoration:none;}
.btn-watch:hover{background:#c92d42;transform:translateY(-3px);box-shadow:0 12px 32px rgba(230,57,80,0.4)}
.hero-right{position:absolute;right:80px;top:50%;transform:translateY(-50%) perspective(1000px) rotateY(-5deg);width:220px;}
.hero-cover{width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:14px;box-shadow:0 30px 60px rgba(0,0,0,0.8),0 0 0 1px rgba(255,255,255,0.1);animation:coverFloat 6s ease-in-out infinite;}
@keyframes coverFloat{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-12px) rotate(1deg)}}
.hero-dots{position:absolute;bottom:55px;left:50%;transform:translateX(-50%);display:flex;gap:10px;z-index:5;}
.hero-dot{width:24px;height:4px;border-radius:2px;background:rgba(255,255,255,0.2);cursor:pointer;transition:all .3s;}
.hero-dot.active{background:var(--accent);width:40px;box-shadow:0 0 10px var(--glow);}

/* Filters & Home Body */
.genre-filters{padding:20px 44px 0;display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;}
.genre-filters::-webkit-scrollbar{display:none;}
.filter-chip{padding:6px 16px;background:var(--card);border:1px solid var(--border);border-radius:20px;font-size:0.75rem;font-weight:600;color:var(--muted2);cursor:pointer;transition:all 0.3s cubic-bezier(0.4, 0, 0.2, 1);white-space:nowrap;}
.filter-chip:hover, .filter-chip.active{background:var(--text);color:var(--bg);border-color:var(--text);transform: translateY(-2px); box-shadow: 0 4px 12px rgba(255,255,255,0.1); }

/* Button press feedback */
button:active, .btn-watch:active, .filter-chip:active, .server-btn:active, .action-btn:active, .ep-box:active {
  transform: scale(0.95) !important;
}

#page-body{padding:0 0 80px}
.strip-section{padding:36px 0 0}
.strip-head{display:flex;align-items:center;justify-content:space-between;padding:0 44px;margin-bottom:18px}
.strip-title{font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:1.5px;display:flex;align-items:center;gap:12px;}
.strip-title .bar{width:4px;height:22px;background:var(--accent);border-radius:2px;}
.h-scroll{display:flex;gap:16px;overflow-x:auto;padding:6px 44px 20px;scrollbar-width:none; cursor:grab; mask-image: linear-gradient(to right, transparent, white 44px, white calc(100% - 44px), transparent); -webkit-mask-image: linear-gradient(to right, transparent, white 44px, white calc(100% - 44px), transparent); }
.h-scroll:active {cursor:grabbing;}
.h-scroll::-webkit-scrollbar{display:none}
.h-scroll.dragging .a-card, .h-scroll.dragging .cw-card { pointer-events: none; }

@keyframes cardEntrance { from { opacity: 0; transform: translateY(30px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

/* Premium Anime Cards */
.a-card { flex-shrink: 0; width: 160px; cursor: pointer; border-radius: 12px; background: var(--card); border: 1px solid var(--border); position: relative; transition: all 0.3s cubic-bezier(0.34, 1.3, 0.64, 1); display: flex; flex-direction: column; text-decoration: none; color: inherit; will-change: transform, opacity; }
.a-card:hover { transform: translateY(-8px) scale(1.02); border-color: var(--accent); box-shadow: 0 15px 40px var(--glow); z-index: 10; }
.a-card:hover .a-card-img { filter: blur(3px) brightness(0.5); }
.a-card-overlay { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity .3s; z-index:2; }
.a-card:hover .a-card-overlay { opacity:1; }
.a-card-play { width:46px; height:46px; border-radius:50%; background:rgba(230,57,80,0.9); display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.1rem; }
.a-card-img-wrap { position: relative; width: 100%; aspect-ratio: 2/3; overflow: hidden; border-radius: 11px 11px 0 0; }
.a-card-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.a-card-body { padding: 12px 10px; background: transparent; display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; height: 62px; }
.a-card-title { font-size: 0.85rem; font-weight: 600; line-height: 1.3; color: var(--text); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 0; flex: 1; padding: 0; }
.btn-fav { position: relative; inset: auto; flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; color: var(--muted2); border: none; cursor: pointer; transition: all 0.2s; z-index: 5; }
.btn-fav:hover { background: rgba(255,255,255,0.2); color: #fff; }
.btn-fav.saved { color: var(--accent); }
.card-badges { position: absolute; bottom: 12px; left: 8px; display: flex; gap: 4px; z-index: 3; pointer-events: none; }
.badge-item { display: flex; align-items: center; gap: 4px; padding: 2px 5px; border-radius: 4px; font-size: 0.65rem; font-weight: 700; line-height: 1; }
.badge-item svg { width: 11px; height: 11px; fill: currentColor; }
.badge-sub { background: rgba(6, 6, 15, 0.85); border: 1px solid var(--accent2); color: var(--accent2); }
.badge-dub { background: var(--accent); color: #fff; border: 1px solid var(--accent); }
.badge-ep { background: rgba(6, 6, 15, 0.85); border: 1px solid var(--muted2); color: var(--text); }
.live-badge{position:absolute;top:8px;right:8px;background:rgba(0,0,0,0.8);backdrop-filter:blur(4px);border:1px solid rgba(78,255,158,0.3);border-radius:6px;padding:3px 8px;font-size:0.6rem;font-weight:700;color:#4eff9e;display:flex;align-items:center;gap:4px;z-index:2;}
.a-card-score{position:absolute;top:8px;left:8px;background:rgba(0,0,0,0.8);backdrop-filter:blur(4px);border-radius:6px;padding:3px 8px;font-size:0.65rem;font-weight:700;color:#ffd700;z-index:2;}

/* Continue Watching Progress */
.cw-card{flex-shrink:0;width:240px;cursor:pointer;border-radius:12px;overflow:hidden;background:var(--card);border:1px solid var(--border);position:relative;transition:all .3s;text-decoration:none;color:inherit;}
.cw-card:hover{transform:translateY(-5px);border-color:var(--accent);box-shadow:0 10px 30px var(--glow);}
.cw-thumb-wrap{position:relative;width:100%;aspect-ratio:16/9;overflow:hidden}
.cw-thumb{width:100%;height:100%;object-fit:cover;display:block}
.cw-thumb-overlay{position:absolute;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .3s;}
.cw-card:hover .cw-thumb-overlay{opacity:1}
.cw-play{width:46px;height:46px;border-radius:50%;background:rgba(230,57,80,0.9);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.1rem;}
.cw-info{padding:12px 14px}
.cw-title{font-size:0.85rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:6px}
.cw-ep{font-size:0.75rem;color:var(--muted2);margin-bottom:10px;display:flex;justify-content:space-between;}
.cw-bar{height:4px;background:rgba(255,255,255,0.1);border-radius:2px;overflow:hidden}
.cw-fill{height:100%;background:linear-gradient(90deg, var(--accent2), var(--accent));border-radius:2px;box-shadow:0 0 10px var(--glow);}

/* Empty States & Skeletons */
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;text-align:center;color:var(--muted);}
.empty-state svg{font-size:3rem;margin-bottom:16px;opacity:0.3;}
.skeleton{background:linear-gradient(90deg,var(--card) 25%,var(--card2) 50%,var(--card) 75%);background-size:200%;animation:shimmer 1.5s infinite;border-radius:12px;}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:10px 20px;font-size:.83rem;color:var(--text);opacity:0;transition:all .3s;z-index:999;pointer-events:none;white-space:nowrap;}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* --- SEARCH / BROWSE VIEW --- */
#search-view { padding: 100px 44px 80px; flex: 1; }

/* NEW ADVANCED FILTER UI */
#smart-filter-system { display: none; background: var(--card2); padding: 24px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 24px; flex-direction: column; gap: 20px; animation: slideDown 0.3s ease-out forwards; }
#smart-filter-system.active { display: flex; }
@keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
.filter-section-title { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 12px; display: block; }
.filter-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
.f-group { display: flex; align-items: center; background: var(--card); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; transition: 0.2s;}
.f-group:hover { border-color: var(--muted); }
.f-label { padding: 8px 12px; font-size: 0.8rem; font-weight: 700; color: #fff; border-right: 1px solid var(--border); white-space: nowrap; }
.f-select { background: transparent; color: var(--muted); border: none; padding: 8px 24px 8px 12px; outline: none; font-family: inherit; font-size: 0.8rem; cursor: pointer; appearance: none; -webkit-appearance: none; background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%238888aa%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E"); background-repeat: no-repeat; background-position: right 8px top 50%; background-size: 10px auto; }
.f-select option { background: var(--surface); color: #fff; }
.f-select.active-val { color: var(--accent); } 
.f-group-multi { display: flex; align-items: center; background: var(--card); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
.f-input-text { background: transparent; border: none; color: var(--accent); padding: 8px; width: 70px; outline: none; font-size: 0.8rem; text-align: center; }
.f-input-text::placeholder { color: var(--muted); }
.genre-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.genre-chip { padding: 6px 14px; background: transparent; border: 1px solid var(--muted); border-radius: 6px; font-size: 0.75rem; font-weight: 500; color: var(--text); cursor: pointer; transition: all 0.2s; user-select: none; }
.genre-chip:hover { border-color: var(--text); }
.genre-chip.active { background: rgba(230, 57, 80, 0.1); border-color: var(--accent); color: var(--accent); }
.filter-actions { display: flex; gap: 12px; margin-top: 10px; align-items: center; }
.btn-filter-submit { background: var(--accent); color: #fff; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: 0.2s; }
.btn-filter-submit:hover { background: #c92d42; box-shadow: 0 4px 15px var(--glow); }
.btn-filter-close { background: transparent; color: var(--muted); border: 1px solid var(--border); padding: 10px 16px; border-radius: 6px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: 0.2s; }
.btn-filter-close:hover { color: #fff; border-color: var(--muted); }

.search-view-header { margin-bottom: 32px; }
.search-back-btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: var(--card); border: 1px solid var(--border); border-radius: 8px; color: var(--muted2); font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-bottom: 20px; text-decoration: none; }
.search-back-btn:hover { border-color: var(--muted2); color: var(--text); transform: translateX(-3px); }
.search-view-title { font-family: 'Bebas Neue', sans-serif; font-size: 2.4rem; letter-spacing: 2px; display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
.search-view-title .bar { width: 5px; height: 32px; background: var(--accent); border-radius: 2px; flex-shrink: 0; }
.search-view-subtitle { font-size: 0.85rem; color: var(--muted2); padding-left: 19px; }
.search-results-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 18px; margin-top: 28px; }
.search-results-grid .a-card { flex-shrink: unset; width: 100%; }
.skeleton-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 18px; margin-top: 28px; }
.skeleton-card { aspect-ratio: 2/3; border-radius: 12px; }

/* --- ZORO-STYLE WATCH VIEW --- */
#watch-view { padding: 90px 44px 40px; max-width: 1650px; width: 100%; margin: 0 auto; }
.breadcrumb { font-size: 0.8rem; color: var(--muted2); margin-bottom: 20px; display: flex; gap: 8px; }
.breadcrumb span { color: var(--text); font-weight: 600; cursor: pointer; }
.watch-layout { display: grid; grid-template-columns: 1fr 340px; gap: 24px; align-items: start; }
.player-container { background: #000; border-radius: 8px; overflow: hidden; aspect-ratio: 16/9; width: 100%; height: auto; margin-bottom: 16px; position: relative; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
.player-container iframe { width: 100%; height: 100%; border: none; display: block; position: absolute; top: 0; left: 0; }
