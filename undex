function setupPlayerLogic(player, skipBtn, skipTimes, ep) {
    let currentSkip = null;
    let resumeApplied = false;
    const resumeAt = pendingResumeTime;
    const applyResume = () => {
        if(resumeApplied || resumeAt==null || !player || !Number.isFinite(player.duration) || player.duration<=0) return;
        resumeApplied = true;
        player.currentTime = Math.max(0, Math.min(player.duration-0.25, Number(resumeAt)||0));
        pendingResumeTime = null;
    };
    player.on('loadedmetadata', applyResume);
    player.on('durationchange', applyResume);
    maybeEnterFullscreen(player);
    let nextEpisodePrefetched = false;
    const nextBtn = document.getElementById('auto-next-btn');
    const anbText = document.getElementById('anb-text');
    
    // 📱 AUTO-LANDSCAPE ON FULLSCREEN LOGIC
    player.on('enterfullscreen', () => {
        if (screen.orientation && screen.orientation.lock) {
            screen.orientation.lock('landscape').catch((err) => console.log("Orientation lock not supported on this device"));
        }
    });

    player.on('exitfullscreen', () => {
        if (screen.orientation && screen.orientation.unlock) {
            screen.orientation.unlock();
        }
    });
    
    player.on('timeupdate', () => {
        const t = player.currentTime;
        const d = player.duration;
        if(Number.isFinite(t) && t>0) schedulePlaybackSave();
        
        currentSkip = skipTimes.find(s => t >= s.interval.startTime && t <= s.interval.endTime);
        if (currentSkip) {
            if (skipBtn) {
                skipBtn.innerText = `Skip ${currentSkip.skipType.toUpperCase()} `;
                skipBtn.style.display = "block";
            }
        } else {
            if (skipBtn) skipBtn.style.display = "none";
        }

        if (isAutoNext && ep < state.totalEps && d > 0) {
            const timeLeft = Math.ceil(d - t);
            
            if (timeLeft <= 10 && timeLeft > 0) {
                if (nextBtn) {
                    nextBtn.classList.add('show');
                    anbText.textContent = `Playing in ${timeLeft}s`;
                }
            } else {
                if (nextBtn) nextBtn.classList.remove('show');
            }

            if (!nextEpisodePrefetched && t > d * 0.60) {
                nextEpisodePrefetched = true;
                prefetchNextEpisode(ep + 1);
            }
        }
    });

    if (skipBtn) {
        skipBtn.addEventListener('click', () => {
            if (currentSkip) player.currentTime = currentSkip.interval.endTime;
            skipBtn.style.display = "none";
        });
    }

    player.on('ended', () => {
        if (isAutoNext && ep < state.totalEps) {
            playEp(ep + 1);
        }
    });
    if (typeof setupPartyPlayerListeners === 'function') {
        setupPartyPlayerListeners(player);
    }
}

function prefetchNextEpisode(nextEp) {
  const nextApiUrl = `https://anivexa-api-tawny.vercel.app/watch/anikoto/${state.animeId}/${state.lang}/anikoto-${nextEp}`;
  fetch(nextApiUrl)
    .then(r => r.json())
