<script>
      // 1. Enhanced Mobile & iPad Detection
      function isMobileDevice() {
          const userAgent = navigator.userAgent || navigator.vendor || window.opera;
          const isStandardMobile = /Android|webOS|iPhone|iPod|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
          const isIPad = (navigator.platform === 'MacIntel' || userAgent.includes('Macintosh')) && navigator.maxTouchPoints > 1;
          const isSmallScreen = window.innerWidth <= 768;

          return isStandardMobile || isIPad || isSmallScreen;
      }

      // 2. Video Player Setup
      function setupVideoPlayer(videoElement, streamUrl) {
          videoElement.setAttribute('playsinline', 'true');
          videoElement.setAttribute('webkit-playsinline', 'true');
          videoElement.setAttribute('x5-playsinline', 'true');
          videoElement.removeAttribute('controls');

          if (window.hlsInstance) {
              try { window.hlsInstance.destroy(); } catch (_) {}
          }

          if (streamUrl && typeof Hls !== 'undefined' && Hls.isSupported()) {
              const hls = new Hls({
                  maxBufferLength: 30,
                  maxMaxBufferLength: 90,
                  enableWorker: true,
                  backBufferLength: 30
              });
              window.hlsInstance = hls;
              hls.attachMedia(videoElement);
              hls.on(Hls.Events.MEDIA_ATTACHED, () => hls.loadSource(streamUrl));
              hls.on(Hls.Events.MANIFEST_PARSED, function () {
                  initPlyr(videoElement);
              });
          } else {
              videoElement.src = streamUrl || '';
              initPlyr(videoElement);
          }
      }


      // 3. Initialize Plyr for Desktop
      function initPlyr(videoElement) {
          if (!window.player) {
              window.player = new Plyr(videoElement, {
                  controls: [
                      'play-large', 'play', 'progress', 'current-time', 
                      'duration', 'mute', 'volume', 'captions', 
                      'settings', 'pip', 'airplay', 'fullscreen'
                  ]
              });
          }
      }
    </script>



