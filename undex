function makeCard(a, index = 0, lazy = false){
  const el = document.createElement('a'); 
  el.className = 'a-card';
  el.dataset.animeId = String(a.id);
  el.href = `/watch/${a.id}/${toSlug(getTitle(a.title))}`;
  el.style.animation = `cardEntrance 0.5s cubic-bezier(0.34,1.3,0.64,1) ${index * 0.04}s both`;
  
  if (lazy) {
    el.dataset.anime = JSON.stringify(a);
    el.dataset.index = index;
    el.innerHTML = `
      <div class="a-card-img-wrap skeleton" style="aspect-ratio:2/3; border-radius: 11px 11px 0 0;"></div>
      <div class="a-card-body" style="height:62px; display:flex; align-items:center; padding:12px 10px;">
        <div class="skeleton" style="height:12px; width:75%; border-radius:3px;"></div>
      </div>`;
    lazyCardObserver.observe(el);
  } else {
    renderCardContents(el, a, index);
  }
  return el;
}

